# Copy to .env for local overrides. Never commit real values.
MODEL_PROVIDER=mock            # mock | bedrock | (others later)
AWS_PROFILE=                   # only for the optional AWS path
AWS_REGION=us-east-1
TABLE_NAME=fairtable-dev
DDB_ENDPOINT_URL=http://localhost:8000   # DynamoDB Local; leave empty for real DynamoDB
