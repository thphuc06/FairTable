# Copy to .env for local overrides. Never commit real values.
MODEL_PROVIDER=mock            # mock (default, no key) | deepseek (opt-in, paid) | bedrock (later)
DEEPSEEK_API=                  # only for MODEL_PROVIDER=deepseek; put the real key in .env, never here
# DEEPSEEK_MODEL=deepseek-flash  # default (light model); DEEPSEEK_BASE_URL defaults to https://api.deepseek.com
# AWS_PROFILE=               # only for the optional AWS path; leave it commented out: an EMPTY value breaks boto3 (ProfileNotFound)
# AWS_REGION=us-east-1
TABLE_NAME=fairtable-dev
DDB_ENDPOINT_URL=http://localhost:8001   # DynamoDB Local from docker compose; leave it out for real DynamoDB

# --- Server (python -m server); all optional in the local profile ---
# APP_PROFILE=local
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# AUTH_ISSUER=http://localhost:9000
# AUTH_AUDIENCE=fairtable-mcp
# SLOT_TOKEN_SECRET=            # 32+ characters; required when APP_PROFILE=aws
# RATE_LIMIT_PER_HOUR=20
# WEB_PUBLIC_URL=http://localhost:8080
# HOLD_TTL_S=600
# WEB_PORT=8080
# WEB_SESSION_SECRET=           # 16+ characters; required when APP_PROFILE=aws
# NOTIFY_TOPIC_ARN=             # AWS profile only: an SNS topic that also gets waitlist and Fair Drop notices (D-054)
