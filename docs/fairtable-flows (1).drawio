<mxfile host="app.diagrams.net" agent="FairTable diagram generator" version="24.7.0"><diagram id="trust" name="1. Trust pipeline (2 PEPs)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1510" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="LB" value="FairTable MCP server on Runtime · PEP-2 (stateful, cedarpy)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="960" height="1155" as="geometry" /></mxCell><mxCell id="LA" value="AgentCore Gateway · PEP-1 (stateless)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="600" height="700" as="geometry" /></mxCell><mxCell id="LC" value="DynamoDB" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="810" width="900" height="360" as="geometry" /></mxCell><mxCell id="a1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L2" target="L2n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L4" target="L4n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fw" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="L5" target="R1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="675" /><mxPoint x="650" y="135" /></Array></mxGeometry></mxCell><mxCell id="b1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R2" target="R3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R3" target="R3n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R3" target="R3y"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R2" target="R4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R4" target="R4a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R4" target="R5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R5" target="R6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R6" target="R6a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R6" target="R6b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="695" /><mxPoint x="1030" y="736" /></Array></mxGeometry></mxCell><mxCell id="b11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R6" target="R7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R7" target="R8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R8" target="R8n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="R8" target="R9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;Trust pipeline for ONE tool call: two policy enforcement points, one policy language (Cedar)&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1300" height="30" as="geometry" /></mxCell><mxCell id="L1" value="tools/call at Gateway&lt;br&gt;(MCP + user Bearer token)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="125" y="100" width="250" height="60" as="geometry" /></mxCell><mxCell id="L2" value="JWT valid?&lt;br&gt;(Cognito JWKS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="140" y="210" width="220" height="100" as="geometry" /></mxCell><mxCell id="L2n" value="401 – rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="410" y="235" width="190" height="50" as="geometry" /></mxCell><mxCell id="L3" value="Request interceptor: copy user token → x-ft-user-token; strip any value the client sent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="110" y="350" width="280" height="70" as="geometry" /></mxCell><mxCell id="L4" value="Cedar PEP-1:&lt;br&gt;permit and no forbid?&lt;br&gt;(G1–G4)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="220" height="110" as="geometry" /></mxCell><mxCell id="L4n" value="Tool hidden / denied (default deny)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="410" y="495" width="190" height="60" as="geometry" /></mxCell><mxCell id="L5" value="Forward to Runtime: OAuth via AgentCore Identity + user-token header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="280" height="70" as="geometry" /></mxCell><mxCell id="R1" value="Re-verify the user token (joserfc + Cognito JWKS); no valid token on a tools/call → HTTP 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="240" height="84" as="geometry" /></mxCell><mxCell id="R2" value="Read tool?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="215" width="220" height="90" as="geometry" /></mxCell><mxCell id="R3" value="Token bucket OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="200" height="90" as="geometry" /></mxCell><mxCell id="R3n" value="RATE_LIMITED + retry_after + next_step: waitlist_watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1300" y="235" width="300" height="50" as="geometry" /></mxCell><mxCell id="R3y" value="Read result + next_step (+ slot-picker UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="340" width="200" height="50" as="geometry" /></mxCell><mxCell id="R4" value="Idempotency key seen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="390" width="220" height="100" as="geometry" /></mxCell><mxCell id="R4a" value="Same params → return stored result&lt;br&gt;Different params → IDEMPOTENCY_CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#B26A00;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1050" y="410" width="300" height="60" as="geometry" /></mxCell><mxCell id="R5" value="Build Cedar context: live counters + read-back facts: code, pause, spoken yes (read from DynamoDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="750" y="540" width="260" height="64" as="geometry" /></mxCell><mxCell id="R6" value="Cedar PEP-2 (P0 + S1, S2, S4, S5a–c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="650" width="230" height="60" as="geometry" /></mxCell><mxCell id="R6a" value="deny → POLICY_DENIED + rule_id + hint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1070" y="640" width="330" height="50" as="geometry" /></mxCell><mxCell id="R6b" value="no spoken yes yet → CONFIRMATION_REQUIRED + fresh read-back (nothing is booked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#B26A00;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1070" y="710" width="330" height="52" as="geometry" /></mxCell><mxCell id="R7" value="TransactWriteItems: slot · counters · hold · idempotency · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="750" y="850" width="260" height="64" as="geometry" /></mxCell><mxCell id="R8" value="Conditions met?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="770" y="950" width="220" height="90" as="geometry" /></mxCell><mxCell id="R8n" value="SLOT_TAKEN + alternatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1070" y="970" width="280" height="50" as="geometry" /></mxCell><mxCell id="R9" value="Audit + result + booking-card UI (MCP Apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="750" y="1085" width="260" height="56" as="geometry" /></mxCell><mxCell id="rules1" value="&lt;b&gt;PEP-1 rules (AgentCore Policy, Cedar)&lt;/b&gt;&lt;br&gt;&lt;b&gt;G1&lt;/b&gt; Read tools: any caller with a valid JWT.&lt;br&gt;&lt;b&gt;G2&lt;/b&gt; Write tools: needs a username claim and the scope fairtable/book.&lt;br&gt;&lt;b&gt;G3&lt;/b&gt; party_size &amp;gt; 10 → forbid (large groups call the restaurant).&lt;br&gt;&lt;b&gt;G4&lt;/b&gt; forbid &lt;i&gt;unless&lt;/i&gt; (principal &lt;b&gt;has&lt;/b&gt; agent_tier &amp;amp;&amp;amp; agent_tier == &quot;verified&quot;).&lt;br&gt;The has-guard matters: when a token lacks the claim, a plain comparison makes the policy error out and be skipped, so the bot is let in (tested with cedarpy). M2M tokens also need the Cognito pre-token V3 trigger to carry agent_tier." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFF8E1;strokeColor=#E0A800;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="1240" width="600" height="235" as="geometry" /></mxCell><mxCell id="rules2" value="&lt;b&gt;PEP-2 rules (cedarpy inside the server)&lt;/b&gt;&lt;br&gt;&lt;b&gt;P0&lt;/b&gt; permit: verified agents only.&lt;br&gt;&lt;b&gt;S1&lt;/b&gt; At most 2 active holds per diner per restaurant.&lt;br&gt;&lt;b&gt;S2&lt;/b&gt; Agent-share cap: covers booked through agents + party size ≤ the owner's cap; also enforced when a watch or lottery entry is converted into a hold.&lt;br&gt;&lt;b&gt;S4&lt;/b&gt; Slots under a lottery drop can only be entered through waitlist_watch.&lt;br&gt;&lt;b&gt;S5a&lt;/b&gt; Confirm needs the read-back code of this hold, this user and these terms (missing, wrong or stale → refused with a fresh read-back).&lt;br&gt;&lt;b&gt;S5b&lt;/b&gt; The pause since the read-back must be over (3 s, 6 s when the restaurant charges a fee).&lt;br&gt;&lt;b&gt;S5c&lt;/b&gt; The assistant must state that the diner said yes (user_confirmed); a cancel that costs money works the same way, in two calls.&lt;br&gt;Every policy carries @id and @on_deny annotations. cedarpy reports policyN; the server maps it to rule_id and decides deny vs. needs-yes (priority: deny &amp;gt; needs-yes &amp;gt; allow; no matching permit = POLICY_DENIED). Hold sweeper: EventBridge Scheduler + Lambda release expired holds every minute, and the server also checks expires_at on every read (DynamoDB TTL is never used for business logic)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFF8E1;strokeColor=#E0A800;rounded=1;" vertex="1" parent="1"><mxGeometry x="670" y="1240" width="960" height="260" as="geometry" /></mxCell><mxCell id="tag_a2" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="373.985" y="252.5" width="22.03" height="15" as="geometry" /></mxCell><mxCell id="tag_a3" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="237.238" y="322.5" width="25.5231" height="15" as="geometry" /></mxCell><mxCell id="tag_a5" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="373.985" y="517.5" width="22.03" height="15" as="geometry" /></mxCell><mxCell id="tag_a6" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="237.238" y="602.5" width="25.5231" height="15" as="geometry" /></mxCell><mxCell id="tag_b2" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1007.24" y="252.5" width="25.5231" height="15" as="geometry" /></mxCell><mxCell id="tag_b3" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1263.98" y="252.5" width="22.03" height="15" as="geometry" /></mxCell><mxCell id="tag_b4" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1137.24" y="314.5" width="25.5231" height="15" as="geometry" /></mxCell><mxCell id="tag_b5" value="No (write)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="849.758" y="332.5" width="60.4831" height="15" as="geometry" /></mxCell><mxCell id="tag_b6" value="seen" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1003.75" y="432.5" width="32.5094" height="15" as="geometry" /></mxCell><mxCell id="tag_b7" value="new" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="865.355" y="507.5" width="29.2894" height="15" as="geometry" /></mxCell><mxCell id="tag_b9" value="deny" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#C5221F;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1013.31" y="657.5" width="33.3719" height="15" as="geometry" /></mxCell><mxCell id="tag_b10" value="no yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#B26A00;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1006.17" y="708.5" width="47.6606" height="15" as="geometry" /></mxCell><mxCell id="tag_b11" value="allow" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1E8E3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="862.337" y="772.5" width="35.3269" height="15" as="geometry" /></mxCell><mxCell id="tag_b13" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1008.99" y="987.5" width="22.03" height="15" as="geometry" /></mxCell><mxCell id="tag_b14" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="867.238" y="1054.5" width="25.5231" height="15" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="drop" name="2. Fair Drop (verifiable lottery)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="590" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1463" y="250" /><mxPoint x="175" y="250" /></Array></mxGeometry></mxCell><mxCell id="f6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f7" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;Fair Drop: a transparent lottery instead of &quot;fastest bot wins&quot; – one entry per real diner, agent-share cap respected&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1500" height="30" as="geometry" /></mxCell><mxCell id="s1" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;1&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Owner sets the drop rule and the agent-share cap (S2), e.g. dinner tables Fri–Sat open 14 days ahead at 10:00." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s2" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;2&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;T − 24 h: KMS generates a random seed; the commitment SHA-256(seed) is published." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="362" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s3" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;3&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;T − 10 min: entries open through waitlist_watch(drop_id), delivered as an MCP Task." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="684" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s4" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;4&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Each entry passes PEP-1 and PEP-2: one entry per verified diner, inside the agent-share cap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1006" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s5" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;5&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;T: entries close and the seed is revealed. Order = HMAC(seed, entry_id)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1328" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s6" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;6&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Allocate in that order, respecting the agent-share cap and each diner's limits (S1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="270" height="110" as="geometry" /></mxCell><mxCell id="s7" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;7&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Winners get a HOLD (one TransactWriteItems); the winner is notified and confirms by voice (read-back, then a spoken yes) before it expires." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="362" y="300" width="270" height="110" as="geometry" /></mxCell><mxCell id="s8" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;8&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;An unconfirmed hold expires; the next person on the waitlist is offered the table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="684" y="300" width="270" height="110" as="geometry" /></mxCell><mxCell id="s9" value="&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;9&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The audit file (seed, hashed entries, order) is published to S3 so anyone can recompute the result." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1006" y="300" width="270" height="110" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Why a lottery?&lt;/b&gt; &quot;First come, first served&quot; rewards fast networks and bots; a lottery gives every verified diner the same chance. &lt;b&gt;Risks:&lt;/b&gt; diners may suspect a rigged draw → commit–reveal plus a public audit file. Many accounts per person → one entry per verified diner, inside the agent-share cap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="760" height="100" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Bots and floods:&lt;/b&gt; bots without a real diner behind them are stopped by PEP-1 / PEP-2; floods hit the token bucket. Results arrive through the MCP Task (or waitlist_status), so nobody has to poll. The agent-share cap keeps part of the tables for phone and walk-in guests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="750" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="eval" name="3. Eval pipeline (ablation)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Gr" value="2 · Run episodes (k times per task)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="810" height="420" as="geometry" /></mxCell><mxCell id="Gg" value="1 · Generate tasks" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="260" height="420" as="geometry" /></mxCell><mxCell id="c1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="spec" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gen" target="seed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3" v