4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gate" target="ship"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gate" target="fix"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.315789;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;" edge="1" parent="1" source="rep" target="ace"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;Eval pipeline: graded on final DB state, pass^k, and an ablation – A0 open storefront · A1 FairTable · A2 no voice guards&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1600" height="30" as="geometry" /></mxCell><mxCell id="spec" value="&lt;b&gt;Task specs (YAML)&lt;/b&gt;&lt;br&gt;HAPPY 12 · NEG 8 · ROB 8 · ADV 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="220" height="80" as="geometry" /></mxCell><mxCell id="gen" value="Task generator: compose restaurant × goal × noise × attack (τ²-bench style)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="220" height="80" as="geometry" /></mxCell><mxCell id="seed" value="Seed DynamoDB&lt;br&gt;fresh namespace per run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="220" height="70" as="geometry" /></mxCell><mxCell id="ua" value="&lt;b&gt;User simulator A&lt;/b&gt; (model 1)&lt;br&gt;tools: say · yes · no · stay silent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="220" height="70" as="geometry" /></mxCell><mxCell id="ub" value="&lt;b&gt;User simulator B&lt;/b&gt; (model 2)&lt;br&gt;impatient / walks away" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="350" y="240" width="220" height="70" as="geometry" /></mxCell><mxCell id="ag" value="&lt;b&gt;Alexa+ simulator agent&lt;/b&gt;&lt;br&gt;(same code as the demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="200" height="80" as="geometry" /></mxCell><mxCell id="ft" value="&lt;b&gt;FairTable server&lt;/b&gt;&lt;br&gt;config A0 / A1 / A2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="175" width="190" height="80" as="geometry" /></mxCell><mxCell id="abl" value="&lt;b&gt;Ablation&lt;/b&gt;&lt;br&gt;&lt;b&gt;A0&lt;/b&gt; open storefront: allow-all, no Trust Kernel (like other MCP booking servers)&lt;br&gt;&lt;b&gt;A1&lt;/b&gt; FairTable, full&lt;br&gt;&lt;b&gt;A2&lt;/b&gt; FairTable without the voice guards S5a–c: whatever the assistant sends counts as the diner's yes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="330" height="150" as="geometry" /></mxCell><mxCell id="tr" value="OTel traces&lt;br&gt;(CloudWatch)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="60" height="60" as="geometry" /></mxCell><mxCell id="db" value="Final DynamoDB&lt;br&gt;state" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="965" y="530" width="60" height="60" as="geometry" /></mxCell><mxCell id="jd" value="&lt;b&gt;AgentCore Evaluations&lt;/b&gt;&lt;br&gt;LLM-as-judge (batch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="210" height="70" as="geometry" /></mxCell><mxCell id="dc" value="&lt;b&gt;Disclosure checker&lt;/b&gt;&lt;br&gt;exact match (stretch: Automated Reasoning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="690" y="660" width="190" height="70" as="geometry" /></mxCell><mxCell id="sg" value="&lt;b&gt;State grader&lt;/b&gt;&lt;br&gt;expected booking / hold exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="190" height="70" as="geometry" /></mxCell><mxCell id="fg" value="&lt;b&gt;Safety grader&lt;/b&gt;&lt;br&gt;no spoken yes, &amp;gt; 2 holds, unverified write, wrong fee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1110" y="660" width="280" height="70" as="geometry" /></mxCell><mxCell id="met" value="&lt;b&gt;Metrics&lt;/b&gt;: pass@1 · pass^k = E[C(c,k)/C(n,k)] · C_out = E[(2p̂−1)²] · violations · block rate · &lt;b&gt;false-block rate&lt;/b&gt; · p50/p95 · cost per booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="460" y="790" width="1170" height="70" as="geometry" /></mxCell><mxCell id="rep" value="&lt;b&gt;Report&lt;/b&gt;: pass^k curves for k = 1..8 (A0 vs A1) · violations chart · split by user simulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="460" y="900" width="760" height="70" as="geometry" /></mxCell><mxCell id="gate" value="Regression gate:&lt;br&gt;no worse than baseline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1280" y="880" width="220" height="110" as="geometry" /></mxCell><mxCell id="ship" value="Tag release · update demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1290" y="1030" width="200" height="50" as="geometry" /></mxCell><mxCell id="fix" value="Back to code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1560" y="915" width="170" height="40" as="geometry" /></mxCell><mxCell id="ace" value="&lt;b&gt;ACE loop (optional)&lt;/b&gt;: Reflector → Curator (tool-description deltas) → human review → re-run on held-out tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="460" y="1030" width="480" height="60" as="geometry" /></mxCell><mxCell id="cad" value="&lt;b&gt;Cadence&lt;/b&gt;&lt;br&gt;Daily: 10 tasks × k=2 (local) · Weekly: 40 × k=4 (cloud) · Final: 12 × k=8.&lt;br&gt;Reports are split by user simulator, because simulators can differ by several points." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="380" height="120" as="geometry" /></mxCell><mxCell id="tag_c6" value="MCP" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="859.673" y="207.5" width="30.655" height="15" as="geometry" /></mxCell><mxCell id="tag_c8" value="traces" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="729.842" y="392.5" width="40.315" height="15" as="geometry" /></mxCell><mxCell id="tag_c9" value="writes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="974.85" y="392.5" width="40.3006" height="15" as="geometry" /></mxCell><mxCell id="tag_r3" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1377.24" y="1002.5" width="25.5231" height="15" as="geometry" /></mxCell><mxCell id="tag_r4" value="No" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1518.98" y="927.5" width="22.03" height="15" as="geometry" /></mxCell><mxCell id="rt1" value="&lt;b&gt;Red team RT1–RT12&lt;/b&gt;&lt;br&gt;blocked or succeeded per configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1420" y="660" width="210" height="70" as="geometry" /></mxCell><mxCell id="m4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.849462;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt1" target="met"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="voice" name="4. Spoken confirmation (voice)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Spoken confirmation: the diner's yes is relayed by the assistant and guarded by the server (D-051)&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1400" height="30" as="geometry" /></mxCell><mxCell id="GA" value="Assistant (a model that relays the diner's words)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="600" height="1380" as="geometry" /></mxCell><mxCell id="GS" value="FairTable server · Trust Kernel (PEP-1, then PEP-2)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=bottom;align=left;spacingLeft=8;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="940" height="1380" as="geometry" /></mxCell><mxCell id="A1" value="Diner: &quot;Book Luna for two tomorrow at seven.&quot;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="170" y="100" width="320" height="60" as="geometry" /></mxCell><mxCell id="A2" value="availability_check(time_window 19:00-19:00)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="230" width="280" height="70" as="geometry" /></mxCell><mxCell id="A3" value="reservation_hold(offer_id, idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="380" width="280" height="70" as="geometry" /></mxCell><mxCell id="A4" value="Reads the details back and asks: &quot;A table for two at Luna, Saturday 7 PM. Free cancellation. Shall I book it?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="170" y="520" width="320" height="90" as="geometry" /></mxCell><mxCell id="A5" value="Diner: &quot;Yes, please.&quot;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="170" y="700" width="320" height="60" as="geometry" /></mxCell><mxCell id="A6" value="reservation_confirm(hold_id, key, read_back_code, user_confirmed = true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="830" width="280" height="80" as="geometry" /></mxCell><mxCell id="A7" value="Says &quot;Booked.&quot; (spoken_summary + booking code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="1260" width="280" height="60" as="geometry" /></mxCell><mxCell id="S1" value="Slots, each with a short offer_id (8 characters, stored 15 minutes, at most 5 shown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="230" width="300" height="70" as="geometry" /></mxCell><mxCell id="S2" value="Hold for 10 minutes (one TransactWriteItems) → read_back sentence + read_back_code (11 characters) + min_pause_s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="370" width="300" height="90" as="geometry" /></mxCell><mxCell id="D1" value="S5a: code fits this hold, user and terms?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="825" width="300" height="90" as="geometry" /></mxCell><mxCell id="D2" value="S5b: pause over? (3 s, 6 s with a fee)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="965" width="300" height="90" as="geometry" /></mxCell><mxCell id="D3" value="S5c: user_confirmed = true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="1105" width="300" height="90" as="geometry" /></mxCell><mxCell id="S3" value="TransactWriteItems: reservation (confirmation = spoken, read_back_at) · counters · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="1250" width="300" height="80" as="geometry" /></mxCell><mxCell id="RF" value="CONFIRMATION_REQUIRED + next_step. S5a also hands over a fresh read-back. Nothing is booked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1260" y="965" width="300" height="90" as="geometry" /></mxCell><mxCell id="N1" value="&lt;b&gt;What this proves, and what not&lt;/b&gt;&lt;br&gt;The server cannot hear the diner. These guards stop mistakes: not asking, asking in the same breath, confirming other terms, another user's code. They do not stop a model that lies on purpose; the restaurant's rules (S1, S2, S4, G3, G4) and the audit bound the damage. I1 / I3 check afterwards that every reservation has its read-back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFF8E1;strokeColor=#E0A800;rounded=1;" vertex="1" parent="1"><mxGeometry x="1130" y="230" width="480" height="150" as="geometry" /></mxCell><mxCell id="N2" value="&lt;b&gt;Why short codes?&lt;/b&gt;&lt;br&gt;A speech model changed one character of a 295-character signed token and every hold was refused. An 8-character offer id, an 11-character code and a 32-character hold id were copied correctly in every trial (D-059). The code carries the moment of issue (half seconds) and 40 bits of HMAC over kind, subject, user and terms; nothing is stored for it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFF8E1;strokeColor=#E0A800;rounded=1;" vertex="1" parent="1"><mxGeometry x="1130" y="400" width="480" height="150" as="geometry" /></mxCell><mxCell id="v1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="S1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A2" target="A3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A3" target="S2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="S2" target="A4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A4" target="A5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A5" target="A6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A6" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#545B64;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tag_v9" value="Yes" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;spacing=0;" verte