r=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="h" target="hs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q14" value="đã thấy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="h" target="hc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q15" value="mới" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="h" target="i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i" target="j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q17" value="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j" target="jd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q18" value="step-up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j" target="js"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q19" value="allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#