<mxfile host="app.diagrams.net" agent="FairTable v2 design generator" version="24.7.0"><diagram id="trust" name="1. Trust pipeline (2 PEP)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Trust pipeline cho MỘT tool call – 2 điểm thực thi luật, cùng ngôn ngữ Cedar&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="LA" value="AgentCore Gateway – PEP-1 (không trạng thái)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="470" height="780" as="geometry"/></mxCell><mxCell id="LB" value="FairTable MCP trên Runtime – PEP-2 (có trạng thái, cedarpy)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="510" y="55" width="790" height="780" as="geometry"/></mxCell><mxCell id="LC" value="DynamoDB" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1280" height="210" as="geometry"/></mxCell><mxCell id="a" value="tools/call tới Gateway&lt;br&gt;(MCP, Bearer của người dùng)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="200" height="50" as="geometry"/></mxCell><mxCell id="b" value="JWT hợp lệ?&lt;br&gt;(Cognito JWKS,&lt;br&gt;allowedClients)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="200" height="100" as="geometry"/></mxCell><mxCell id="bn" value="401 – từ chối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="195" width="200" height="50" as="geometry"/></mxCell><mxCell id="c" value="REQUEST interceptor&lt;br&gt;chép user token → header&lt;br&gt;x-ft-user-token&lt;br&gt;(stretch: kiểm Web Bot Auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="d" value="Cedar PEP-1:&lt;br&gt;có permit và&lt;br&gt;không forbid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="200" height="110" as="geometry"/></mxCell><mxCell id="dn" value="Tool bị ẩn / từ chối&lt;br&gt;(default deny)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="270" y="440" width="200" height="55" as="geometry"/></mxCell><mxCell id="dnote" value='&lt;b&gt;G1&lt;/b&gt; tool đọc: mọi caller có JWT hợp lệ&lt;br&gt;&lt;b&gt;G2&lt;/b&gt; tool ghi: có username + scope fairtable/book&lt;br&gt;&lt;b&gt;G3&lt;/b&gt; party_size &amp;gt; 10 → forbid (nhóm lớn gọi quán)&lt;br&gt;&lt;b&gt;G4&lt;/b&gt; forbid &lt;i&gt;unless&lt;/i&gt; (principal &lt;b&gt;has&lt;/b&gt; agent_tier &amp;amp;&amp;amp; agent_tier == "verified")&lt;br&gt;→ thiếu &lt;b&gt;has&lt;/b&gt;-guard thì token M2M không có claim sẽ làm policy lỗi và bị bỏ qua (đã thử bằng cedarpy)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="430" height="125" as="geometry"/></mxCell><mxCell id="fwd" value="Chuyển tiếp tới Runtime&lt;br&gt;(OAuth outbound qua AgentCore Identity&lt;br&gt;+ header user token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="70" as="geometry"/></mxCell><mxCell id="e" value="Xác minh lại user token&lt;br&gt;(joserfc + Cognito JWKS)&lt;br&gt;gắn danh tính cho elicitation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="95" width="210" height="70" as="geometry"/></mxCell><mxCell id="f" value="Tool đọc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="195" width="210" height="90" as="geometry"/></mxCell><mxCell id="g" value="Token bucket&lt;br&gt;OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="195" width="180" height="90" as="geometry"/></mxCell><mxCell id="gn" value="RATE_LIMITED + retry_after&lt;br&gt;+ next_step: waitlist_watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="185" width="305" height="45" as="geometry"/></mxCell><mxCell id="gy" value="Kết quả đọc + next_step&lt;br&gt;(+ slot-picker UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="245" width="305" height="45" as="geometry"/></mxCell><mxCell id="h" value="Idempotency&lt;br&gt;key đã thấy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="315" width="210" height="90" as="geometry"/></mxCell><mxCell id="hs" value="cùng tham số →&lt;br&gt;trả kết quả đã lưu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="305" width="180" height="45" as="geometry"/></mxCell><mxCell id="hc" value="khác tham số →&lt;br&gt;IDEMPOTENCY_CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="180" height="45" as="geometry"/></mxCell><mxCell id="i" value="Dựng Cedar context:&lt;br&gt;bộ đếm trực tiếp + standing mandate&lt;br&gt;(đọc DynamoDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="435" width="210" height="75" as="geometry"/></mxCell><mxCell id="j" value="Cedar PEP-2&lt;br&gt;(P0 + S1–S4)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="540" width="210" height="100" as="geometry"/></mxCell><mxCell id="jd" value="deny → lỗi có cấu trúc&lt;br&gt;code + rule_id + hint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="535" width="180" height="50" as="geometry"/></mxCell><mxCell id="js" value="step-up → -32042&lt;br&gt;consent URL → duyệt&lt;br&gt;trên điện thoại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#B26A00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="180" height="60" as="geometry"/></mxCell><mxCell id="jnote" value="&lt;b&gt;S1&lt;/b&gt; ≤ 2 hold đang giữ / người / quán&lt;br&gt;&lt;b&gt;S2&lt;/b&gt; agent share: covers qua agent + party ≤ trần chủ quán đặt&lt;br&gt;&lt;b&gt;S3&lt;/b&gt; confirm trong hội thoại chỉ khi standing mandate phủ booking; nếu không → step-up&lt;br&gt;&lt;b&gt;S4&lt;/b&gt; slot thuộc drop chỉ vào qua waitlist_watch&lt;br&gt;Mỗi policy có &lt;b&gt;@id&lt;/b&gt; và &lt;b&gt;@on_deny&lt;/b&gt;; cedarpy trả policyN → server tra annotation ra rule_id (đã thử với cedarpy 4.12.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="975" y="330" width="305" height="190" as="geometry"/></mxCell><mxCell id="k" value="TransactWriteItems&lt;br&gt;slot · bộ đếm · hold · idem · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="890" width="210" height="60" as="geometry"/></mxCell><mxCell id="l" value="Điều kiện&lt;br&gt;ghi thỏa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="875" width="180" height="90" as="geometry"/></mxCell><mxCell id="ln" value="SLOT_TAKEN + alternatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="870" width="305" height="45" as="geometry"/></mxCell><mxCell id="ly" value="audit + kết quả&lt;br&gt;+ booking-card UI (MCP Apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="930" width="305" height="50" as="geometry"/></mxCell><mxCell id="sweepnote" value="Hold sweeper (EventBridge Scheduler mỗi 1 phút → Lambda) trả hold hết hạn; server cũng kiểm hạn khi đọc. Không dựa vào TTL (xóa trễ tới vài ngày). Việc trả slot đi qua Streams → watch matcher." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="460" height="90" as="geometry"/></mxCell><mxCell id="q1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;htm