height="95" as="geometry"/></mxCell><mxCell id="p1" value="T − 24h: KMS tạo seed ngẫu nhiên&lt;br&gt;công bố commitment = SHA-256(seed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="182" y="250" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="T − 10 phút: nhận phiếu qua&lt;br&gt;waitlist_watch(drop_id) dạng MCP Task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="344" y="110" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="Mỗi phiếu qua PEP-1 + PEP-2:&lt;br&gt;1 phiếu/người (ghi có điều kiện), đúng standing mandate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="506" y="250" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4" value="T: đóng cửa · lộ seed&lt;br&gt;thứ tự = HMAC(seed, entry_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="668" y="110" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5" value="Phân bổ theo thứ tự, tôn trọng&lt;br&gt;ràng buộc mandate + trần agent share" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6" value="Người thắng: HOLD (TransactWriteItems)&lt;br&gt;tự xác nhận nếu mandate phủ; nếu không → step-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="992" y="110" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7" value="Hold không xác nhận → sweeper trả slot&lt;br&gt;→ watch matcher mời người kế tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1154" y="250" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8" value="Công bố audit lên S3: seed,&lt;br&gt;phiếu đã băm, thứ tự → ai cũng tính lại được" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="110" width="150" height="95" as="geometry"/></mxCell><mxCell id="tl8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value='&lt;b&gt;Vì sao xổ số?&lt;/b&gt; "Ai đến trước" ưu tiên người có mạng nhanh hoặc bot; xổ số cho mọi người cơ hội ngang nhau. &lt;b&gt;Rủi ro:&lt;/b&gt; người mua nghi ngờ bốc thăm gian lận → commit–reveal + audit công khai; nhiều tài khoản → 1 phiếu/người đã xác minh + mandate.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="900" height="70" as="geometry"/></mxCell><mxCell id="n2" value="Bot không có mandate của người thật bị chặn ở PEP-1/PEP-2; gửi dồn dập bị token bucket chặn; kết quả trả qua MCP Task nên không cần polling. Trần agent share (S2) giữ lại phần chỗ cho khách gọi điện / walk-in." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="eval" name="3. Eval pipeline (ablation)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Eval pipeline – chấm theo trạng thái DB, pass^k, ablation A0 (cửa hàng mở) · A1 (FairTable) · A2 (không step-up)&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="spec" value="&lt;b&gt;Task specs (YAML)&lt;/b&gt;&lt;br&gt;HAPPY 12 · NEG 8 · ROB 8 · ADV 12&lt;br&gt;quán × mục tiêu × nhiễu × tấn công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="gen" value="Generator ghép thành phần&lt;br&gt;(kiểu τ²-bench)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="170" height="60" as="geometry"/></mxCell><mxCell id="seed" value="Seed DynamoDB&lt;br&gt;namespace mới mỗi lần chạy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="170" height="60" as="geometry"/></mxCell><mxCell id="usa" value="User sim A (model 1)&lt;br&gt;tool: say · approve_consent · decline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="665" y="45" width="220" height="65" as="geometry"/></mxCell><mxCell id="usb" value="User sim B (model 2)&lt;br&gt;persona vội / bỏ đi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="665" y="135" width="220" height="65" as="geometry"/></mxCell><mxCell id="agent" value="Alexa+ sim agent&lt;br&gt;(cùng code với demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="925" y="85" width="190" height="70" as="geometry"/></mxCell><mxCell id="fd" value="FairTable&lt;br&gt;cấu hình A0 / A1 / A2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="85" width="180" height="70" as="geometry"/></mxCell><mxCell id="abl" value="&lt;b&gt;Ablation&lt;/b&gt;&lt;br&gt;A0 cửa hàng mở: allow-all, không Trust Kernel (kiểu OpenBook/G-Guest)&lt;br&gt;A1 FairTable đầy đủ&lt;br&gt;A2 FairTable, luôn xác nhận trong hội thoại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1360" y="60" width="320" height="105" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB&lt;br&gt;trạng thái cuối" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1210" y="250" width="60" height="60" as="geometry"/></mxCell><mxCell id="cw" value="OTel traces&lt;br&gt;(CloudWatch)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="990" y="250" width="60" height="60" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;State grader&lt;/b&gt;&lt;br&gt;booking / hold mong đợi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="190" height="60" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Safety grader&lt;/b&gt;&lt;br&gt;không consent · vượt mandate · &amp;gt;2 hold ·&lt;br&gt;ghi khi chưa verified · sai phí" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="390" width="210" height="80" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;AgentCore Evaluations&lt;/b&gt;&lt;br&gt;LLM-as-judge (batch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="200" height="60" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;Disclosure checker&lt;/b&gt;&lt;br&gt;so khớp chính xác&lt;br&gt;(Automated Reasoning offline – stretch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="395" width="210" height="70" as="geometry"/></mxCell><mxCell id="met" value="&lt;b&gt;Metrics&lt;/b&gt;: pass@1 · pass^k = E[C(c,k)/C(n,k)] · C_out = E[(2p̂−1)²]&lt;br&gt;vi phạm · block rate · &lt;b&gt;false-block rate&lt;/b&gt; · p50/p95 · cost/booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="530" width="470" height="70" as="geometry"/></mxCell><mxCell id="rep" value="&lt;b&gt;Báo cáo&lt;/b&gt;: đường pass^k k=1..8 (A0 vs A1) · biểu đồ vi phạm · tách theo simulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="470" height="50" as="geometry"/></mxCell><mxCell id="gate" value="Regression gate:&lt;br&gt;không tệ hơn&lt;br&gt;baseline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="620" width="170" height="100" as="geometry"/></mxCell><mxCell id="ship" value="Tag release · cập nhật demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="750" width="170" height="45" as="geometry"/></mxCell><mxCell id="fix" value="Quay lại code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C5221F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="755" width="150" height="40" as="geometry"/></mxCell><mxCell id="ace" value="&lt;b&gt;Vòng ACE (Could)&lt;/b&gt;: Reflector → Curator (delta mô tả tool) → người duyệt → chạy lại trên held-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#147EBA;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="360" height="60" as="geometry"/></mxCell><mxCell id="cad" value="&lt;b&gt;Nhịp chạy&lt;/b&gt;: hằng ngày 10 task × k=2 (local) · hằng tuần 40 × k=4 (cloud) · chốt 12 × k=8&lt;br&gt;Báo cáo tách theo từng user simulator (các simulator có thể lệch vài điểm %)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="520" height="70" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spec" ta