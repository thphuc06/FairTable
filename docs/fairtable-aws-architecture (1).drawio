" value="Nova 2 Sonic&lt;br&gt;(voice page)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nova2;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="880" width="60" height="60" as="geometry" /></mxCell><mxCell id="mem" value="AgentCore Memory&lt;br&gt;(optional)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#6C757D;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=2;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="60" height="60" as="geometry" /></mxCell><mxCell id="bud" value="AWS Budgets&lt;br&gt;alerts $1 · $3 · $4.5" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="765" y="780" width="60" height="60" as="geometry" /></mxCell><mxCell id="sched" value="EventBridge Scheduler&lt;br&gt;every minute + drops" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.eventbridge_scheduler;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="800" width="60" height="60" as="geometry" /></mxCell><mxCell id="wk" value="Lambda workers" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1370" y="800" width="60" height="60" as="geometry" /></mxCell><mxCell id="kms" value="AWS KMS&lt;br&gt;(lottery seed)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1520" y="785" width="60" height="60" as="geometry" /></mxCell><mxCell id="s3" value="Amazon S3&lt;br&gt;(audit file)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1520" y="905" width="60" height="60" as="geometry" /></mxCell><mxCell id="legend0" value="&lt;b&gt;Booking path: diner → Alexa+ → MCP server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;1&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Diner talks to the Alexa+ simulator (voice or text).&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;2&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Simulator signs the diner in (Cognito password flow in the demo; a real Alexa+ uses OAuth code + PKCE); a pre-token Lambda adds agent_tier and agent_id to the token.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;3&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Simulator sends MCP tools/call (Streamable HTTP, spec 2025-11-25) with the diner's Bearer token to AgentCore Gateway.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;RT&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;A red-team bot with an M2M token calls the same endpoint; rules G2 and G4 block it.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;4&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Gateway validates the JWT against Cognito's JWKS.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;5&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Request interceptor copies the user token into x-ft-user-token and strips any value the client sent.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;6&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;AgentCore Policy checks Cedar rules G1–G4 (default deny) before the tool runs.&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;7&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Gateway calls the Runtime with its service role (SigV4).&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;8&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Gateway forwards the call to the Runtime; the MCP server re-verifies the user token and runs the Trust Kernel (PEP-2: cedarpy P0, S1, S2, S4, S5a–c, S6).&lt;br&gt;&lt;span style=&quot;background-color:#FF9900;color:#232F3E;&quot;&gt;&lt;b&gt;&amp;nbsp;9&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The server commits state with one DynamoDB TransactWriteItems (slot, counters, hold, idempotency record, audit).&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#AAB7B8;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="1165" width="600" height="308" as="geometry" /></mxCell><mxCell id="legend1" value="&lt;b&gt;Owner web and notices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#147EBA;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;10&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;A waitlist match or a Fair Drop win sends one short notice (no user id, no link) to an SNS topic, which e-mails the subscribed address.&lt;br&gt;&lt;span style=&quot;background-color:#147EBA;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;11&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;API Gateway routes the request to the owner-console Lambda (FastAPI).&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;background-color:#147EBA;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;12&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;The Lambda stores the owner's changes and an audit record in DynamoDB.&lt;/i&gt;&amp;nbsp;The console runs locally today, with the same DynamoDB table.&lt;br&gt;&lt;span style=&quot;background-color:#147EBA;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;13&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The owner changes the agent-share cap and reads the audit in the owner console. &lt;i style=&quot;color:#6C757D;&quot;&gt;Editing rules and creating drops: future.&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;background-color:#147EBA;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;14&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;Rule changes are checked with Automated Reasoning before they are applied.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Background workers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#1E8E3E;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;15&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The Lambda workers (hold sweeper, watch matcher, Fair Drop allocator) read and write DynamoDB.&lt;br&gt;&lt;span style=&quot;background-color:#1E8E3E;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;16&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;EventBridge Scheduler runs the workers every minute; a drop is drawn at the first run after its time.&lt;br&gt;&lt;span style=&quot;background-color:#1E8E3E;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;17&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Fair Drop takes its random seed from KMS (GenerateRandom) and publishes the audit file to S3.&lt;br&gt;&lt;br&gt;&lt;b&gt;Observability and evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#7D3C98;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;18&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;Gateway, Policy and Runtime emit OpenTelemetry spans to CloudWatch Transaction Search (optional).&lt;br&gt;&lt;span style=&quot;background-color:#7D3C98;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;19&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;AgentCore Evaluations judges the traces (LLM-as-judge).&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;background-color:#7D3C98;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;20&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The local eval harness runs the tasks and grades the final database state. &lt;i style=&quot;color:#6C757D;&quot;&gt;Submitting sessions for judging: future.&lt;/i&gt;&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#AAB7B8;rounded=1;" vertex="1" parent="1"><mxGeometry x="670" y="1165" width="600" height="308" as="geometry" /></mxCell><mxCell id="legend2" value="&lt;b&gt;Model access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;21&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;The simulator calls Bedrock models and Nova 2 Sonic (voice page). &lt;i style=&quot;color:#6C757D;&quot;&gt;AgentCore Memory: future.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Owner onboarding (stretch)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color:#6C757D;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;22&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;The owner console sends the restaurant's website to AgentCore Browser.&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;background-color:#6C757D;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;23&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;Browser drives Nova Act, which reads the site in a sandbox.&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;background-color:#6C757D;color:#FFFFFF;&quot;&gt;&lt;b&gt;&amp;nbsp;24&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&lt;i style=&quot;color:#6C757D;&quot;&gt;Nova Act's API key is kept in Secrets Manager; the result is only a proposal the owner must approve.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reading the diagram&lt;/b&gt;&lt;br&gt;Numbers follow the legend. Dashed lines are optional features. Circles are colour-coded by section.&lt;br&gt;&lt;br&gt;&lt;b&gt;Simplifications&lt;/b&gt;&lt;br&gt;Cognito includes its pre-token Lambda trigger. &quot;Lambda workers&quot; = hold sweeper + watch matcher + Fair Drop allocator. Bedrock models serve the simulator, the voice page and the real-model evaluation runs; &lt;i style=&quot;color:#6C757D;&quot;&gt;the judge and owner-rule extraction are future.&lt;/i&gt; Static hosting (CloudFront / S3) for the owner console is omitted.&lt;br&gt;&lt;br&gt;&lt;b&gt;Local profile (what judges run)&lt;/b&gt;&lt;br&gt;The same server runs with docker compose: DynamoDB Local, a dev JWT issuer instead of Cognito, and a mock model. No AWS account needed; the AWS path above is used for the demo video and the AWS Builder challenge.&lt;br&gt;&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#AAB7B8;rounded=1;" vertex="1" parent="1"><mxGeometry x="1300" y="1165" width="600" height="308" as="geometry" /></mxCell><mxCell id="badge_e1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="144" y="359" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="307.5" y="259" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="329" y="534" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e_rt" value="RT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#C5221F;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="259" y="684" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="429" y="473" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="499" y="549" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="639" y="549" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="779" y="549" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="961.5" y="549" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF9900;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1231.5" y="549" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1309" y="650" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1314" y="259" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1389" y="415.5" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e13" value="13" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1154" y="69" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e14" value="14" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#147EBA;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1519" y="244" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e15" value="15" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E8E3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1389" y="684" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e16" value="16" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E8E3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1284" y="819" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e17a" value="17" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E8E3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1464" y="804" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e18" value="18" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7D3C98;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1074" y="438.5" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e19" value="19" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7D3C98;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="921.5" y="259" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e20" value="20" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7D3C98;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="514" y="74" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e21a" value="21" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#01A88D;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="149" y="789" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e22" value="22" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6C757D;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1549" y="411.5" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e23" value="23" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6C757D;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1699" y="614" width="22" height="22" as="geometry" /></mxCell><mxCell id="badge_e24" value="24" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6C757D;strokeColor=#232F3E;fontColor=#FFFFFF;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="1699" y="744" width="22" height="22" as="geometry" /></mxCell><mxCell id="sns" value="Amazon SNS&lt;br&gt;(waitlist / Fair Drop notices)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1290" y="920" width="60" height="60" as="geometry" /></mxCell><mxCell id="mail" value="E-mail&lt;br&gt;(subscribed address)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="920" width="60" height="60" as="geometry" /></mxCell><mxCell id="note_future" value="Italic grey = future improvement (production roadmap), not built in this MVP. The owner console exists today but runs locally, not on Lambda." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#6C757D;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1485" width="1860" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>