<mxfile host="app.diagrams.net" agent="FairTable v2 design generator" version="24.7.0"><diagram id="arch" name="AWS architecture v2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;FairTable v2 – AWS architecture (us-east-1)&lt;/b&gt; · nét đứt = tùy chọn / stretch · ①–⑦ xem chú giải góc trái dưới" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="1100" height="30" as="geometry"/></mxCell><mxCell id="diner" value="Diner (Mỹ)&lt;br&gt;giọng nói / text" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="60" height="60" as="geometry"/></mxCell><mxCell id="sim" value="&lt;b&gt;Alexa+ Simulator&lt;/b&gt; (local trong MVP)&lt;br&gt;Strands 1.57.1 · web UI&lt;br&gt;AppBridge (host MCP Apps)&lt;br&gt;elicitation callback" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="178" width="200" height="80" as="geometry"/></mxCell><mxCell id="evalh" value="&lt;b&gt;Eval harness&lt;/b&gt; (local; cloud hằng tuần)&lt;br&gt;2 user sim · k lần/task&lt;br&gt;ablation A0 / A1 / A2" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="285" width="200" height="70" as="geometry"/></mxCell><mxCell id="phone" value="Điện thoại của diner&lt;br&gt;(duyệt consent)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" vertex="1" parent="1"><mxGeometry x="80" y="395" width="60" height="60" as="geometry"/></mxCell><mxCell id="bot" value="Agent bên thứ ba /&lt;br&gt;bot red-team (M2M)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_application;" vertex="1" parent="1"><mxGeometry x="80" y="525" width="60" height="60" as="geometry"/></mxCell><mxCell id="owner" value="Chủ nhà hàng" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="80" y="665" width="60" height="60" as="geometry"/></mxCell><mxCell id="alexa_real" value="&lt;b&gt;Alexa+ thật&lt;/b&gt; (khi mở Preview): add-on qua MCP Toolkit trỏ vào cùng endpoint Gateway; account linking giữ nguyên ①" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="775" width="200" height="70" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Luồng chính&lt;/b&gt;&lt;br&gt;① Account linking: OAuth code + PKCE&lt;br&gt;② MCP + Bearer token của người dùng&lt;br&gt;③ PEP-1: JWT → interceptor → Cedar G1–G4&lt;br&gt;④ tools/call (OAuth outbound) + header user token&lt;br&gt;⑤ PEP-2 (cedarpy) → TransactWriteItems&lt;br&gt;⑥ Step-up -32042 → duyệt trên điện thoại&lt;br&gt;