// Schema for the PEP-2 policies (P0, S1-S4, S3b). Used only to validate the policy files at load
// time; requests are not validated against it. Every context field is required so that a missing
// value can never make a forbid rule silently skip (see docs/PLAN.md section 3a, cedarpy).
entity Diner;
entity Venue = { agent_cover_cap: Long };

type Ctx = {
  agent_tier: String,
  active_holds_user_venue: Long,
  agent_covers_booked: Long,
  party_size: Long,
  mandate_covers_booking: Bool,
  slot_is_drop_controlled: Bool,
  cancel_fee_cents: Long,
  cancel_fee_acknowledged: Bool,
};

action reservation_hold, reservation_confirm, reservation_manage, waitlist_watch
  appliesTo { principal: Diner, resource: Venue, context: Ctx };
